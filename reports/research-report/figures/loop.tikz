% kernscope closed loop: profile -> capture -> analyze -> transform/generate -> verify -> benchmark
% Included from report.tex via \input.  Requires tikz + positioning + arrows.meta.
\begin{tikzpicture}[
    node distance=2.1cm and 1.35cm,
    box/.style={draw, rectangle, rounded corners=2pt, align=center,
                minimum height=9mm, minimum width=20mm, fill=#1,
                font=\small},
    box/.default=gray!12,
    lbl/.style={font=\scriptsize\itshape, text=black!60},
    arr/.style={-{Stealth[length=2.2mm]}, thick},
    feed/.style={-{Stealth[length=2.2mm]}, dashed, thick, gray!70},
  ]
  % ---- the six stages ----
  \node[box=blue!10]                 (prof)   {profile\\\scriptsize kernscope-profile};
  \node[box=blue!10, right=of prof]  (cap)    {capture\\\scriptsize kernscope-capture};
  \node[box=blue!10, right=of cap]   (ana)    {analyze\\\scriptsize kernscope-analyze};
  \node[box=green!10, right=of ana]  (trans)  {transform / generate\\\scriptsize tune (templates) + pass (LLVM)};
  \node[box=orange!10, right=of trans] (ver)  {verify\\\scriptsize kernscope-verify (8 check classes)};
  \node[box=red!8,    right=of ver]  (bench)  {benchmark\\\scriptsize libs/bench, L2 flush, p20/p80};

  % ---- main flow ----
  \draw[arr] (prof)  -- node[above, font=\scriptsize] {hot kernel}        (cap);
  \draw[arr] (cap)   -- node[above, font=\scriptsize] {bundle}            (ana);
  \draw[arr] (ana)   -- node[above, font=\scriptsize] {findings}          (trans);
  \draw[arr] (trans) -- node[above, font=\scriptsize] {variants}          (ver);
  \draw[arr] (ver)   -- node[above, font=\scriptsize] {gated}             (bench);

  % ---- closed-loop feedback ----
  \draw[feed] (bench.south) -- ++(0,-0.85) -| node[pos=0.25, below, font=\scriptsize]
             {delta reports (provenance-labeled)} (prof.south);

  % ---- tool annotations under the boxes ----
  \node[lbl, below=5.5mm of prof]   {rocm-smi clocks as-measured};
  \node[lbl, below=5.5mm of cap]    {rocprofiler-sdk intercept, bitwise replay};
  \node[lbl, below=5.5mm of ana]    {PTX / AMDGPU ISA of the *captured* kernel};
  \node[lbl, below=5.5mm of trans]  {roofline + occupancy pre-screen};
  \node[lbl, below=5.5mm of ver]    {clang $\to$ LLVM IR gate};
  \node[lbl, below=5.5mm of bench]  {correctness-gated, median + p20/p80};
\end{tikzpicture}

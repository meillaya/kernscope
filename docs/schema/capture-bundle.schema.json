{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernscope.local/schemas/capture-bundle.schema.json",
  "title": "kernscope capture bundle (v1)",
  "description": "Normative shape of a v1 kernscope capture bundle (docs/capture-format.md, todo 46). Three JSON documents live in a *.kcap/ directory: manifest.json (envelope + size governance), events.json (formalized event log incl. the per-launch arg marshalling table), blobs.json (VA-faithful blob index with mandatory sha256 provenance and embedded-pointer patch tables). Blob bytes live in blobs/<id>.bin. All 64-bit integer fields (pointers, original VAs, sizes, handles) are lowercase hex strings with a 0x prefix per docs/capture-format.md §1.1. The C++ BundleReader in libs/capture-core is the enforcing implementation; this schema is the normative reference.",
  "type": "object",
  "required": ["manifest", "events", "blobs"],
  "properties": {
    "manifest": {
      "type": "object",
      "required": ["format_id", "schema_version", "tool_version", "vendor", "arch", "capture_mechanism", "timestamp", "snapshot_policy", "size_governance"],
      "properties": {
        "format_id": { "const": "kernscope-capture" },
        "schema_version": { "type": "string", "pattern": "^1\\.0$" },
        "tool_version": { "type": "string" },
        "vendor": { "enum": ["nvidia", "amd", "mock"] },
        "arch": { "type": "string", "examples": ["sm_80", "gfx1101"] },
        "capture_mechanism": { "enum": ["cupti", "preload", "hip-sdk"] },
        "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*" },
        "snapshot_policy": { "const": "va-faithful" },
        "first_kernel": { "type": "string" },
        "size_governance": {
          "type": "object",
          "required": ["max_snapshot_bytes", "total_blob_bytes", "aborted", "abort_reason"],
          "properties": {
            "max_snapshot_bytes": { "type": "integer", "minimum": 1, "description": "the --max-snapshot-bytes budget (default 1 GiB, docs/capture-format.md §5.1)" },
            "total_blob_bytes": { "type": "integer", "minimum": 0 },
            "aborted": { "type": "boolean", "description": "true => partial bundle from a size-cap abort; the bundle is deliberately partial, not corrupt" },
            "abort_reason": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "description": "The formalized event log, in record order (docs/capture-format.md §3).",
      "items": {
        "type": "object",
        "required": ["type", "seq"],
        "oneOf": [
          { "type": "object", "required": ["type", "name", "calls"], "properties": { "type": { "const": "api" }, "name": { "type": "string" }, "calls": { "type": "integer", "minimum": 0 }, "seq": { "type": "integer" } } },
          { "type": "object", "required": ["type", "ptr", "size", "is_alloc"], "properties": { "type": { "enum": ["alloc", "free"] }, "ptr": { "$ref": "#/$defs/u64hex" }, "size": { "$ref": "#/$defs/u64hex" }, "is_alloc": { "type": "boolean" }, "seq": { "type": "integer" } } },
          { "type": "object", "required": ["type", "ptr", "forwarded"], "properties": { "type": { "const": "unknown-free" }, "ptr": { "$ref": "#/$defs/u64hex" }, "forwarded": { "type": "boolean" }, "seq": { "type": "integer" } } },
          { "type": "object", "required": ["type", "kernel_name", "via", "grid", "block", "shared_mem_bytes", "stream", "graph_handle", "args"], "properties": {
              "type": { "const": "launch" },
              "kernel_name": { "type": "string" },
              "via": { "enum": ["runtime", "runtime-ex", "graph", "driver", "driver-ex"] },
              "grid": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 3, "maxItems": 3 },
              "block": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 3, "maxItems": 3 },
              "shared_mem_bytes": { "type": "integer", "minimum": 0 },
              "stream": { "$ref": "#/$defs/u64hex" },
              "graph_handle": { "$ref": "#/$defs/u64hex" },
              "args": {
                "type": "array",
                "description": "the arg marshalling table (docs/capture-format.md §3.1): scalar/by-value bytes + pointer slots",
                "items": {
                  "type": "object",
                  "required": ["kind", "size", "bytes"],
                  "properties": {
                    "kind": { "enum": ["scalar", "pointer"] },
                    "size": { "type": "integer", "minimum": 0 },
                    "bytes": { "type": "string", "pattern": "^([0-9a-f]{2})*$" },
                    "va": { "$ref": "#/$defs/u64hex", "description": "pointer slots only: the original device VA" }
                  },
                  "additionalProperties": false
                }
              },
              "seq": { "type": "integer" }
            } },
          { "type": "object", "required": ["type", "kind", "dst", "src", "bytes", "cuda_kind", "dst_size", "src_size", "stream"], "properties": {
              "type": { "const": "copy" },
              "kind": { "enum": ["memcpy", "memcpy2d", "memcpy-async", "memcpy2d-async"] },
              "dst": { "$ref": "#/$defs/u64hex" }, "src": { "$ref": "#/$defs/u64hex" },
              "bytes": { "$ref": "#/$defs/u64hex" },
              "cuda_kind": { "type": "integer", "description": "cudaMemcpyKind: 1 H2D, 2 D2H, 3 D2D (capture-mapping M10)" },
              "dst_size": { "$ref": "#/$defs/u64hex" }, "src_size": { "$ref": "#/$defs/u64hex" },
              "stream": { "$ref": "#/$defs/u64hex" }, "seq": { "type": "integer" }
            } },
          { "type": "object", "required": ["type", "ptr", "value", "bytes", "ptr_size", "stream"], "properties": {
              "type": { "const": "memset" },
              "ptr": { "$ref": "#/$defs/u64hex" }, "value": { "type": "integer" },
              "bytes": { "$ref": "#/$defs/u64hex" }, "ptr_size": { "$ref": "#/$defs/u64hex" },
              "stream": { "$ref": "#/$defs/u64hex" }, "seq": { "type": "integer" }
            } },
          { "type": "object", "required": ["type", "sync", "handle", "id"], "properties": {
              "type": { "const": "stream" },
              "sync": { "type": "boolean" }, "handle": { "$ref": "#/$defs/u64hex" },
              "id": { "type": "integer", "minimum": 0 }, "seq": { "type": "integer" }
            } },
          { "type": "object", "required": ["type", "mod", "sha256", "kernels"], "properties": {
              "type": { "enum": ["fatbin", "cubin"] },
              "mod": { "type": "integer", "minimum": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "path": { "type": "string" },
              "kernels": { "type": "array", "items": { "type": "string" } },
              "seq": { "type": "integer" }
            } },
          { "type": "object", "required": ["type", "cufunction", "param_index", "offset", "size"], "properties": {
              "type": { "const": "param_info" },
              "cufunction": { "$ref": "#/$defs/u64hex" },
              "param_index": { "type": "integer", "minimum": 0 },
              "offset": { "type": "integer", "minimum": 0 },
              "size": { "type": "integer", "minimum": 0 },
              "seq": { "type": "integer" }
            } }
        ]
      }
    },
    "blobs": {
      "type": "object",
      "required": ["schema_version", "blobs"],
      "properties": {
        "schema_version": { "type": "string", "pattern": "^1\\.0$" },
        "blobs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "file", "role", "va", "size", "sha256", "patches"],
            "properties": {
              "id": { "type": "string", "pattern": "^b[0-9]{4}$" },
              "file": { "type": "string" },
              "role": { "enum": ["kernel-binary", "input", "output", "arg", "state"] },
              "va": { "$ref": "#/$defs/u64hex", "description": "ORIGINAL virtual address of the buffer (VA-faithful policy); 0x0 for host-side/kernel blobs" },
              "size": { "$ref": "#/$defs/u64hex" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "MANDATORY provenance hash of the blob bytes; the reader verifies it" },
              "patches": {
                "type": "array",
                "description": "embedded-pointer patch table (T** deep pointers), docs/capture-format.md §4.3",
                "items": {
                  "type": "object",
                  "required": ["offset", "target_va"],
                  "properties": {
                    "offset": { "type": "integer", "minimum": 0 },
                    "target_va": { "$ref": "#/$defs/u64hex" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "u64hex": {
      "type": "string",
      "pattern": "^0x[0-9a-f]+$",
      "description": "64-bit integer as lowercase hex string with 0x prefix (JSON numbers cannot represent every u64 above 2^53; docs/capture-format.md §1.1)"
    }
  }
}

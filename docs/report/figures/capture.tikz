% Capture bundle v1: one folder, one event log, one VA snapshot.
\begin{tikzpicture}[
    font=\small,
    stage/.style={draw, rounded corners=3pt, align=center, text width=2.3cm,
                  minimum height=1.1cm, inner sep=3pt, font=\scriptsize, fill=paper},
    part/.style={draw=ink!30, rounded corners=2pt, align=center, text width=1.75cm,
                 minimum height=1.0cm, inner sep=3pt, font=\scriptsize, fill=ink!3},
    flow/.style={-{Stealth[length=2mm]}, line width=0.8pt, draw=ink!60},
    note/.style={font=\scriptsize\itshape, text=ink!60, align=left},
  ]

  % The bundle folder.
  \draw[draw=kviolet, fill=kvioletfill!45, rounded corners=4pt, line width=0.8pt]
    (0.2,-1.9) -- (8.8,-1.9) -- (8.8,2.1) -- (4.1,2.1) -- (3.5,2.7) -- (0.2,2.7) -- cycle;
  \node[font=\small\bfseries, text=kviolet, anchor=west] at (0.35,2.3) {bundle.v1/};

  \node[part, fill=paper] (man) at (1.75,0.75)
    {\texttt{manifest.json}\\{\tiny format, vendor, arch,\\kernel, hashes}};
  \node[part, fill=paper] (events) at (1.75,-0.95)
    {\texttt{events.json}\\{\tiny launches, args,\\memcpys, syncs}};
  \node[part, fill=paper] (blobs) at (4.55,0.75)
    {\texttt{blobs.json}\\{\tiny VA ranges, sizes,\\provenance}};
  \node[part, fill=paper] (snap) at (4.55,-0.95)
    {\texttt{blobs/*.hsaco}\\{\tiny code objects and\\buffer snapshots}};
  \node[part, fill=paper] (repro) at (7.25,0.0)
    {\texttt{reproducer/}\\{\tiny standalone C++\\project}};

  % Record and replay around the folder.
  \node[stage, fill=korangefill, draw=korange] (record) at (-2.0,0.75)
    {\textbf{record}\\running binary};
  \node[stage, fill=kgreenfill, draw=kgreen] (replay) at (11.3,0.75)
    {\textbf{replay}\\restore + launch};
  \node[stage, fill=kbluefill, draw=kblue] (check) at (11.3,-1.55)
    {\textbf{validate}\\bitwise hash};
  \draw[flow] (record) -- (0.2,0.75);
  \draw[flow] (8.8,0.75) -- (replay);
  \draw[flow] (replay) -- (check);
  % The patch table is the subtle part of VA fidelity.
  \node[note, anchor=north west, text width=4.8cm] at (0.35,-2.12)
    {embedded pointers are recorded in a patch table and rewritten to fresh
     virtual addresses on replay; the output hash must match the captured
     reference exactly};
\end{tikzpicture}

% From tool output to the archival report: one schema, one provenance flag.
\begin{tikzpicture}[
    font=\small,
    box/.style={draw=ink!35, rounded corners=3pt, align=center, text width=2.75cm,
                minimum height=2.5cm, inner sep=4pt, font=\scriptsize, fill=paper},
    wide/.style={draw=ink!30, rounded corners=2pt, align=center, inner sep=6pt,
                 font=\scriptsize, fill=ink!4},
    flow/.style={-{Stealth[length=2mm]}, line width=0.8pt, draw=ink!60},
    lbl/.style={font=\scriptsize\itshape, text=ink!60},
  ]

  \node[box, fill=kbluefill, draw=kblue] (tools) at (0,0)
    {\textbf{\color{kblue}six tools}\\[3pt]
     profile \(\bullet\)\ analyze\\
     verify \(\bullet\)\ tune\\
     capture \(\bullet\)\ pass\\[3pt]
     {\scriptsize\ttfamily --json / --html}};
  \node[box, fill=kgreenfill, draw=kgreen] (engine) at (3.8,0)
    {\textbf{\color{kgreen}libs/report}\\[3pt]
     report engine\\
     \texttt{schema\_version} 1.0\\
     per-module\\provenance\\[3pt]
     JSON + self-contained HTML};
  \node[box, fill=korangefill, draw=korange] (runtime) at (7.6,0)
    {\textbf{\color{korange}runtime evidence}\\[3pt]
     \texttt{reports/demo/}\\
     \texttt{reports/passes/}\\
     \texttt{reports/peaks/}\\[3pt]
     regenerated by scripts};
  \node[box, fill=kvioletfill, draw=kviolet] (archive) at (11.4,0)
    {\textbf{\color{kviolet}archive}\\[3pt]
     \texttt{kernscope-dashboard}\\
     dashboard HTML\\[3pt]
     this technical report};

  \draw[flow] (tools) -- node[lbl, above] {emit} (engine);
  \draw[flow] (engine) -- node[lbl, above] {write} (runtime);
  \draw[flow] (runtime) -- node[lbl, above] {aggregate} (archive);

  \node[wide, minimum width=13.0cm] at (5.7,-2.55)
    {\textbf{provenance gate}\quad
     \textcolor{kgreen}{\(\bullet\)}~\texttt{measured} (live gfx1101)\quad
     \textcolor{kblue}{\(\bullet\)}~\texttt{projected} (static / compile-only)\quad
     \(\bullet\)~\texttt{no\_data}\\
     \texttt{tests/report/check\_dashboard.py} asserts every section flag;
     a projected number never occupies a measured slot.};
\end{tikzpicture}

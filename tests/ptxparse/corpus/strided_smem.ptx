.version 8.5
.target sm_86
.address_size 64

// Hand-written strided shared-memory kernel: every thread reads/writes
// sdata[lane * 68] (68 words = bank-conflict stride pattern, cf. brief §3).
.visible .entry strided_smem(
	.param .u32 n
)
{
	.reg .b32 	%r<8>;
	.reg .f32 	%f<4>;
	.reg .b64 	%rd<2>;
	.shared .align 4 .b32 sdata[1024];
	ld.param.u32 	%r1, [n];
	cvta.to.shared.u64 	%rd1, sdata;
	mov.u32 		%r2, %tid.x;
	mul.lo.u32 		%r3, %r2, 68;
	shl.b32 		%r4, %r3, 2;
	add.s64 		%rd2, %rd1, %r4;
	ld.shared.f32 	%f1, [%rd2];
	add.f32 		%f2, %f1, 1.0;
	st.shared.f32 	[%rd2], %f2;
	ret;
}

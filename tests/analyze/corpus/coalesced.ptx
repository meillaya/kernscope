.version 8.5
.target sm_86
.address_size 64

// Hand-written coalescing fixture: a fully-coalesced unit-stride float
// load. Per-lane address = base + tid*4 (one 4-byte word per thread,
// consecutive lanes -> contiguous 128B span -> 4 x 32B sectors, 100%
// utilization; the brief §3.1 canonical "four 32-byte memory
// transactions, 100% utilization" example).
.visible .entry coalesced(
	.param .u64 p
)
{
	.reg .b64 	%rd<3>;
	.reg .f32 	%f<2>;
	.reg .b32 	%r<2>;
	ld.param.u64 	%rd1, [p];
	cvta.to.global.u64 	%rd2, %rd1;
	mov.u32 		%r1, %tid.x;
	mul.wide.s32 	%rd3, %r1, 4;
	add.s64 		%rd4, %rd2, %rd3;
	ld.global.f32 	%f1, [%rd4];
	add.f32 		%f2, %f1, 1.0;
	st.global.f32 	[%rd4], %f2;
	ret;
}

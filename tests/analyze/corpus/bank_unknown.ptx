.version 8.5
.target sm_86
.address_size 64

// Hand-written bank-conflict fixture (QA failure): a DATA-DEPENDENT shared
// index (%r2 is loaded from shared memory). The stride pattern cannot be
// resolved statically -> the module must classify the access "unknown",
// never conflict-free and never a fabricated bank count.
.visible .entry bank_unknown(
	.param .u64 p
)
{
	.reg .b64 	%rd<3>;
	.reg .b32 	%r<4>;
	.reg .f32 	%f<2>;
	.shared .align 4 .b32 sdata[1024];
	ld.param.u64 	%rd1, [p];
	cvta.to.shared.u64 	%rd2, sdata;
	mov.u32 		%r1, %tid.x;
	ld.shared.b32 	%r2, [%rd2];      // data-dependent index
	shl.b32 		%r3, %r2, 2;
	add.s64 		%rd3, %rd2, %r3;
	ld.shared.f32 	%f1, [%rd3];
	add.f32 		%f2, %f1, 1.0;
	st.shared.f32 	[%rd3], %f2;
	ret;
}

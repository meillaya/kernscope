.version 8.5
.target sm_86
.address_size 64

// Hand-written bank-conflict fixture: the PADDED variant of the 68-word
// stride (+1 pad idiom per brief §2.1 L173-179). Stride 69 words:
// 69 % 32 == 5, gcd(5, 32) = 1 -> every lane lands on a distinct bank ->
// conflict-free.
.visible .entry bank_padded(
	.param .u64 p
)
{
	.reg .b64 	%rd<3>;
	.reg .f32 	%f<3>;
	.reg .b32 	%r<4>;
	.shared .align 4 .b32 sdata[4416];
	ld.param.u64 	%rd1, [p];
	cvta.to.shared.u64 	%rd2, sdata;
	mov.u32 		%r1, %tid.x;
	mul.lo.s32 		%r2, %r1, 69;    // stride 69 words (+1 pad)
	shl.b32 		%r3, %r2, 2;      // * 4 bytes
	add.s64 		%rd3, %rd2, %r3;
	ld.shared.f32 	%f1, [%rd3];
	add.f32 		%f2, %f1, 1.0;
	st.shared.f32 	[%rd3], %f2;
	ret;
}

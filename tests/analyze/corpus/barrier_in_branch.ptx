.version 8.5
.target sm_86
.address_size 64

// Hand-written divergence fixture: a bar.sync inside a DIVERGENT region
// (predicated on a threadIdx-derived condition). Some threads never reach
// the barrier -> CUDA UB / deadlock per brief §4.2 L319-323 and the CUDA
// guide's __syncthreads rules -> "divergent barrier" warning.
.visible .entry barrier_in_branch(
	.param .u64 p
)
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<8>;
	.reg .b64 	%rd<2>;
	.reg .f32 	%f<4>;
	ld.param.u64 	%rd1, [p];
	mov.u32 		%r1, %tid.x;
	and.b32 		%r2, %r1, 1;    // tid-derived condition
	setp.eq.s32 	%p1, %r2, 0;    // DIVERGENT predicate
	@%p1 bra 		$L_taken;       // block terminator

$L_fallthrough:
	bar.sync 		0;              // only even lanes reach this barrier
	mov.f32 		%f1, 0f3F800000;
	bra 			$L_join;
$L_taken:
	mov.f32 		%f2, 0f40000000;
$L_join:
	add.f32 		%f3, %f1, %f2;
	st.global.f32 	[%rd1], %f3;
	ret;
}

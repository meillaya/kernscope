def build_model(root: Path, missing: set) -> dict:
    sections = {}
    for name in SECTION_ORDER:
        result = BUILDERS[name](root)
        avail = result["available"]
        summary = result["summary"]
        files = result["files"]
        if name in missing:
            avail, summary, files = False, {}, []
        sections[name] = {
            "title": SECTION_TITLES[name],
            "available": avail,
            "status": "ok" if avail else "no_data",
            "provenance": dict(PROVENANCE[name], sources=files),
            "summary": summary,
            "files": files,
        }
    machine = {"arch": "gfx1101", "device": "AMD Radeon RX 7800 XT",
               "note": "LOCAL numbers only; rental numbers land under "
                       "reports/rentals/ only when the owner produces them."}
    return {
        "schema_version": SCHEMA_VERSION,
        "report_type": REPORT_TYPE,
        "tool_version": TOOL_VERSION,
        "generated": generated_timestamp(),
        "machine": machine,
        "honesty": {
            "rule": "projected numbers are never presented as measured; "
                    "every module section carries provenance.mode + "
                    "provenance.measured (asserted by "
                    "tests/report/check_dashboard.py)",
            "modes": {name: sections[name]["provenance"]["mode"]
                      for name in SECTION_ORDER},
        },
        "loop": {
            "hot_kernel": "_Z15layernorm_fusedPKtS0_S0_Ptfi.kd",
            "diagram": "static inline SVG (profile -> capture -> analyze -> "
                       "tune -> verify -> pass -> benchmark; dashed edge "
                       "closes the loop back to profile)",
            "modules": SECTION_ORDER,
        },
        "sections": sections,
    }


# --------------------------------------------------------------------------
# HTML rendering: self-contained (inline CSS, static SVG diagram, embedded
# JSON payload in <script id="report-data" type="application/json">), zero
# network requests. Rendered statically from the model — the payload is the
# EXACT model JSON (check_html.py round-trips it).
# --------------------------------------------------------------------------

def render_section(name: str, sec: dict) -> str:
    title = html.escape(sec.get("title", name))
    if not sec.get("available"):
        return (f"<section class='module' id='module-{name}' "
                f"data-available='false'>"
                f"<h2>{title} <span class='status no_data'>no data</span></h2>"
                f"<p class='nodata'>no data — module report not found on this "
                f"machine (provenance.mode {sec.get('provenance', {}).get('mode', '?')})"
                f"</p></section>")
    prov = sec.get("provenance", {})
    mode = html.escape(prov.get("mode", "unknown"))
    files = "".join(f"<li><code>{html.escape(f)}</code></li>"
                    for f in sec.get("files", []))
    summary = html.escape(json.dumps(sec.get("summary", {}), indent=2))
    return (f"<section class='module' id='module-{name}' data-available='true'>"
            f"<h2>{title} <span class='status {mode}'>{mode}</span></h2>"
            f"<pre class='summary'>{summary}</pre>"
            f"<p class='prov'>provenance: mode=<code>{mode}</code>, "
            f"measured=<code>{prov.get('measured')}</code> — "
            f"{html.escape(prov.get('note', ''))}</p>"
            f"<ul class='evidence'>{files}</ul></section>")


def loop_svg(modes: dict) -> str:
    """Static inline SVG loop: profile -> capture -> analyze (row 1),
    tune -> verify -> pass (row 2, right-to-left), dashed edge closes the
    loop pass -> profile. Colors encode provenance: measured green,
    projected amber, no_data gray. Zero network."""
    color = {"measured": "#3fb950", "projected": "#d29922",
             "no_data": "#8b949e"}
    box_w, box_h, gap = 180, 56, 30
    x1, x2, x3 = 30, 30 + box_w + gap, 30 + 2 * (box_w + gap)
    y1, y2 = 50, 170
    pos = {"profile": (x1, y1), "capture": (x2, y1), "analyze": (x3, y1),
           "tune": (x3, y2), "verify": (x2, y2), "pass": (x1, y2)}
    label = {"profile": "profile", "capture": "capture", "analyze": "analyze",
             "tune": "tune", "verify": "verify", "pass": "pass"}
    parts = ["<svg id='loop-diagram' viewBox='0 0 600 270' "
             "xmlns='http://www.w3.org/2000/svg' role='img' "
             "aria-label='kernscope loop: profile to capture to analyze to "
             "tune to verify to pass and back'>"]
    # arrows between consecutive stages (right arrow on row1, left on row2,
    # down on the analyze->tune wrap).
    def arrow(xa, ya, xb, yb, dashed=False):
        d = ("stroke-dasharray='5,4' " if dashed else "")
        parts.append(f"<line x1='{xa}' y1='{ya}' x2='{xb}' y2='{yb}' "
                     f"stroke='#58a6ff' stroke-width='2' {d}/>")
        # arrowhead
        import math
        ang = math.atan2(yb - ya, xb - xa)
        for da in (0.45, -0.45):
            ax = xb - 10 * math.cos(ang + da)
            ay = yb - 10 * math.sin(ang + da)
            parts.append(f"<line x1='{xb}' y1='{yb}' x2='{ax:.1f}' "
                         f"y2='{ay:.1f}' stroke='#58a6ff' stroke-width='2'/>")
    arrow(x1 + box_w, y1 + box_h / 2, x2, y1 + box_h / 2)
    arrow(x2 + box_w, y1 + box_h / 2, x3, y1 + box_h / 2)
    arrow(x3 + box_w / 2, y1 + box_h, x3 + box_w / 2, y2)  # analyze -> tune
    arrow(x3, y2 + box_h / 2, x2 + box_w, y2 + box_h / 2)  # tune -> verify (L)
    arrow(x2, y2 + box_h / 2, x1 + box_w, y2 + box_h / 2)  # verify -> pass (L)
    arrow(x1 + 10, y2, x1 + 10, y1 + box_h, dashed=True)   # pass -> profile
    for name, (bx, by) in pos.items():
        c = color.get(modes.get(name, "no_data"), "#8b949e")
        parts.append(f"<rect x='{bx}' y='{by}' width='{box_w}' height='{box_h}' "
                     f"rx='8' fill='#161b22' stroke='{c}' stroke-width='2'/>")
        parts.append(f"<text x='{bx + box_w / 2}' y='{by + 24}' "
                     f"text-anchor='middle' fill='#e6edf3' font-size='14' "
                     f"font-weight='600'>{label[name]}</text>")
        parts.append(f"<text x='{bx + box_w / 2}' y='{by + 42}' "
                     f"text-anchor='middle' fill='{c}' font-size='11'>"
                     f"{modes.get(name, 'no_data')}</text>")
    parts.append(f"<text x='300' y='252' text-anchor='middle' fill='#9198a1' "
                 f"font-size='11'>gfx1101 (local) — measured vs projected "
                 f"provenance per module; zero network</text>")
    parts.append("</svg>")
    return "".join(parts)


def escape_payload(payload: str) -> str:
    r"""Escape '</' as '<\/' (valid JSON escape) so a closing </script> can
    never appear inside the payload (same discipline as libs/report)."""
    return payload.replace("</", "<\\/")


def build_html(model: dict) -> str:
    payload = json.dumps(model, indent=2)
    modes = model["honesty"]["modes"]
    sections = "".join(render_section(n, model["sections"][n])
                       for n in SECTION_ORDER)
    machine = model["machine"]
    honesty_rows = "".join(
        f"<tr><td>{html.escape(n)}</td><td><span class='status "
        f"{html.escape(m)}'>{html.escape(m)}</span></td></tr>"
        for n, m in modes.items())
    return f"""<!DOCTYPE html>

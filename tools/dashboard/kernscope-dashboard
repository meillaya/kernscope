#!/usr/bin/env python3
"""kernscope-dashboard — todo-56 aggregator: one self-contained dashboard HTML.

Aggregates the ALREADY-COMMITTED per-module reports into a single static
HTML page (polykernel/tt-flow convention — inline CSS/JS, embedded JSON
payload in <script id="report-data" type="application/json">, zero network
requests, opens offline from file://):

    analyzer  tests/fixtures/expected_fused_attention.json (golden) +
              reports/demo/stage-3-analyze.{json,html} (captured-ISA run)
    tune      reports/tune/*.jsonl (measured gfx1101 search runs) +
              reports/demo/stage-4-capture-tune.json +
              reports/demo/stage-5-verify-tune.json
    verify    tests/verify/manifest.json (corpus: 8 check classes)
    capture   tests/fixtures/capture/layernorm-live/manifest.json + bundle +
              reports/demo/capture/replay.txt (bitwise PASS)
    profile   reports/demo/stage-1-profile.json + reports/peaks/gfx1101-bench.jsonl
    pass      reports/passes/*/report.json (todo 42/54 before/after deltas)

HONESTY DISCIPLINE (MUST NOT present projected numbers as measured): every
module section carries a provenance object whose `mode` is "measured" (live
gfx1101 runs) or "projected" (static analysis / IR+PTX compile-only
artifacts), plus a boolean `measured` mirror — asserted by
tests/report/check_dashboard.py. LOCAL gfx1101 numbers only; rental numbers
land under reports/rentals/ only when the owner produces them.

MISSING-SECTION QA: --missing <sec1,sec2,...> renders those sections as a
"no data" panel with the JSON flag `available: false` — NEVER a broken page
(the embedded payload always parses; the tool still exits 0).

Usage:
    kernscope-dashboard [--out reports/dashboard.html]
                        [--missing verify,profile] [--version]
Writes <out> plus a sibling <basename>.json holding the exact payload
(check_html.py's expected-file convention).

Exit codes: 0 = dashboard written, 2 = internal error.
"""

import argparse
import html
import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path

TOOL_VERSION = "kernscope-dashboard 0.1.0"
SCHEMA_VERSION = "1.0"
REPORT_TYPE = "kernscope_dashboard"

# Reproducible output: when SOURCE_DATE_EPOCH (reproducible-builds
# convention) is set, the "generated" timestamp comes from it so a scripted
# regeneration is byte-identical; otherwise the wall clock is used.
def generated_timestamp() -> str:
    epoch = os.environ.get("SOURCE_DATE_EPOCH")
    if epoch:
        return datetime.fromtimestamp(int(epoch), tz=timezone.utc).strftime(
            "%Y-%m-%dT%H:%M:%SZ")
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

# The six module sections, in the tt-flow six-section report convention.
SECTION_ORDER = ["analyzer", "tune", "verify", "capture", "profile", "pass"]

SECTION_TITLES = {
    "analyzer": "Static analyzer (C1)",
    "tune": "Autotuner (C2)",
    "verify": "Static verifier (C3)",
    "capture": "Capture / replay (C4)",
    "profile": "Profiler (C6)",
    "pass": "LLVM passes + pass→analyzer delta (C5)",
}


def repo_root() -> Path:
    """Resolve the repo root by walking up until tests/verify/manifest.json
    is found. Works from tools/dashboard/ AND from build/bin/ (the copied
    CLI location), i.e. from any CWD."""
    cur = Path(__file__).resolve().parent
    for cand in [cur, *cur.parents]:
        if (cand / "tests" / "verify" / "manifest.json").exists():
            return cand
    return cur


def load_json(path: Path):
    with open(path, encoding="utf-8") as f:
        return json.load(f)


def first_key(d, keys, default=None):
    for k in keys:
        if k in d:
            return d[k]
    return default


def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


# --------------------------------------------------------------------------
# Per-module summary builders. Each returns (available: bool, summary: dict).
# Summaries carry ONLY machine-readable fields + evidence file paths that
# exist on disk (asserted by the check script).
# --------------------------------------------------------------------------

def build_analyzer(root: Path) -> dict:
    golden = root / "tests" / "fixtures" / "expected_fused_attention.json"
    stage3 = root / "reports" / "demo" / "stage-3-analyze.json"
    ptx = root / "tests" / "fixtures" / "fused_attention.ptx"
    files = [golden, stage3, ptx,
             root / "reports" / "demo" / "stage-3-analyze.html"]
    if not all(f.exists() for f in files):
        return {"available": False, "summary": {}, "files": []}
    g = load_json(golden)
    s3 = load_json(stage3)
    m = g.get("metrics", {})
    summary = {
        "golden_kernel": g.get("kernel", "fused_attention"),
        "golden_occupancy": m.get("occupancy"),
        "golden_limiter": m.get("limiter"),
        "golden_registers_per_thread": m.get("registers_per_thread"),
        "golden_warnings": len(g.get("warnings", [])),
        "golden_suggestions": len(g.get("suggestions", [])),
        "captured_isa_findings": [f.get("id") for f in s3.get("warnings", [])],
        "captured_isa_vectorized_ld_global": s3.get(
            "metrics", {}).get("vectorized_ld_global"),
        "captured_isa_spill_bytes": s3.get("metrics", {}).get("spill_bytes"),
    }
    return {"available": True, "summary": summary, "files": [str(f.relative_to(root)) for f in files]}


def build_tune(root: Path) -> dict:
    tune_dir = root / "reports" / "tune"
    jsonl = sorted(tune_dir.glob("*.jsonl"))
    files = list(jsonl) + [
        root / "reports" / "demo" / "stage-4-capture-tune.json",
        root / "reports" / "demo" / "stage-5-verify-tune.json",
    ]
    if not all(f.exists() for f in files):
        return {"available": False, "summary": {}, "files": []}
    families = {}
    for p in jsonl:
        rows = [json.loads(line) for line in p.read_text(
            encoding="utf-8").splitlines() if line.strip()]
        if not rows:
            continue
        fam = rows[0].get("kernel_family", p.stem)
        medians = [r.get("timings", {}).get("median")
                   for r in rows if r.get("timings", {}).get("median")]
        modes = {r.get("provenance", {}).get("mode")
                 for r in rows if r.get("provenance", {}).get("mode")}
        families[fam] = {
            "variants": len(rows),
            "best_median_us": round(min(medians) * 1e6, 3) if medians else None,
            "worst_median_us": round(max(medians) * 1e6, 3) if medians else None,
            "provenance_modes": sorted(modes),
        }
    ct = load_json(root / "reports" / "demo" / "stage-4-capture-tune.json")
    vt = load_json(root / "reports" / "demo" / "stage-5-verify-tune.json")
    summary = {
        "families": families,
        "capture_tune_validated": ct.get("validated"),
        "capture_tune_best_block": ct.get("best", {}).get(
            "config", {}).get("block", [None])[0],
        "capture_tune_speedup": ct.get("speedup"),
        "verify_gate": vt.get("verify_gate"),
        "verifier_gated_variants": vt.get("verifier_gated"),
        "compiled_variants": vt.get("compiled"),
    }
    return {"available": True, "summary": summary, "files": [str(f.relative_to(root)) for f in files]}


def build_verify(root: Path) -> dict:
    manifest = root / "tests" / "verify" / "manifest.json"
    corpus = root / "tests" / "verify" / "corpus"
    if not manifest.exists() or not corpus.is_dir():
        return {"available": False, "summary": {}, "files": []}
    entries = load_json(manifest)
    by_check = {}
    by_verdict = {}
    for e in entries:
        c = e.get("check")
        by_check[str(c)] = by_check.get(str(c), 0) + 1
        v = e.get("expected_verdict")
        by_verdict[v] = by_verdict.get(v, 0) + 1
    files = [manifest, corpus]
    summary = {
        "manifest_entries": len(entries),
        "corpus_source_files": len(list(corpus.glob("*.cu"))),
        "entries_by_check_class": by_check,
        "entries_by_verdict": by_verdict,
        "check_classes": 8,
    }
    return {"available": True, "summary": summary,
            "files": [str(manifest.relative_to(root)), "tests/verify/corpus/"]}


def build_capture(root: Path) -> dict:
    live = root / "tests" / "fixtures" / "capture" / "layernorm-live"
    manifest = live / "manifest.json"
    demo_bundle = root / "reports" / "demo" / "capture" / "bundle.v0"
    replay = root / "reports" / "demo" / "capture" / "replay.txt"
    sample = root / "tests" / "fixtures" / "capture" / "v0-sample.bundle"
    files = [manifest, live / "bundle.v0", sample, demo_bundle, replay,
             root / "reports" / "demo" / "capture" / "output.bin"]
    if not all(f.exists() for f in files):
        return {"available": False, "summary": {}, "files": []}
    m = load_json(manifest)
    replay_txt = read_text(replay)
    summary = {
        "mechanism": m.get("capture", {}).get("mechanism"),
        "bundle_kernel": m.get("bundle", {}).get("kernel"),
        "grid": m.get("bundle", {}).get("grid"),
        "block": m.get("bundle", {}).get("block"),
        "output_sha256": m.get("output", {}).get("sha256"),
        "blob_count": len(m.get("blobs", {}).get("inputs", [])),
        "replay_verdict": "PASS" if "PASS" in replay_txt else "UNKNOWN",
        "replay_bitwise_equal": "bitwise EQUAL" in replay_txt,
        "fixture_bundle": "bundle.v0",
        "demo_bundle_replay": "PASS" if "validation: PASS" in replay_txt else "UNKNOWN",
    }
    return {"available": True, "summary": summary, "files": [str(f.relative_to(root)) for f in files]}


def build_profile(root: Path) -> dict:
    stage1 = root / "reports" / "demo" / "stage-1-profile.json"
    stage1_html = root / "reports" / "demo" / "stage-1-profile.html"
    peaks = root / "reports" / "peaks" / "gfx1101-bench.jsonl"
    files = [stage1, stage1_html, peaks]
    if not all(f.exists() for f in files):
        return {"available": False, "summary": {}, "files": []}
    s1 = load_json(stage1)
    hot = None
    for k in s1.get("kernels", []):
        if k.get("kernel_name", "").startswith("_Z"):
            hot = k
    rows = [json.loads(line) for line in peaks.read_text(
        encoding="utf-8").splitlines() if line.strip()]
    peak_fams = {}
    for r in rows:
        fam = r.get("kernel_family")
        if fam:
            peak_fams[fam] = {
                "median_us": round(r.get("timings", {}).get("median", 0) * 1e6, 3),
                "size_bytes": r.get("config", {}).get("size_bytes"),
                "mode": r.get("provenance", {}).get("mode"),
            }
    summary = {
        "kernel_count": s1.get("kernel_count"),
        "wall_time_ns": s1.get("wall_time_ns"),
        "hot_kernel": hot.get("kernel_name") if hot else None,
        "hot_kernel_duration_ns": hot.get("duration_ns") if hot else None,
        "hot_kernel_occupancy": hot.get("occupancy") if hot else None,
        "hot_kernel_registers": hot.get("registers_per_thread") if hot else None,
        "hot_kernel_hints": hot.get("hints", []),
        "profiler_hint_ids": [h.get("id") for h in s1.get("ranking", [])],
        "peak_bench_families": peak_fams,
    }
    return {"available": True, "summary": summary, "files": [str(f.relative_to(root)) for f in files]}


def build_pass(root: Path) -> dict:
    delta = root / "reports" / "demo" / "stage-5-pass-delta.json"
    pdirs = sorted((root / "reports" / "passes").glob("*/report.json"))
    files = [delta] + list(pdirs)
    if not all(f.exists() for f in files):
        return {"available": False, "summary": {}, "files": []}
    kernels = {}
    for p in pdirs:
        r = load_json(p)
        kernels[r.get("kernel", p.parent.name)] = {
            "transform": r.get("transform"),
            "vector_width_before": r.get("vector_width_before"),
            "vector_width_after": r.get("vector_width_after"),
            "vector_width_increased": r.get("vector_width_increased"),
            "smem_bytes_before": r.get("smem_bytes_before"),
            "smem_bytes_after": r.get("smem_bytes_after"),
            "uncoalesced_before": r.get("coalescing_class_before", {}).get("uncoalesced"),
            "uncoalesced_after": r.get("coalescing_class_after", {}).get("uncoalesced"),
            "ptx_compile_all_exit0": r.get("ptx_compile_all_exit0"),
        }
    d = load_json(delta)
    summary = {
        "kernels": kernels,
        "showcase_delta": d.get("delta", {}),
        "showcase_kernel": d.get("kernel", {}).get("name"),
    }
    return {"available": True, "summary": summary, "files": [str(f.relative_to(root)) for f in files]}



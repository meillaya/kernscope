"""


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(
        prog="kernscope-dashboard",
        description="Aggregate the committed per-module kernscope reports "
                    "into one self-contained dashboard HTML (todo 56).")
    ap.add_argument("--out", default="reports/dashboard.html",
                    help="output HTML path (default reports/dashboard.html); "
                         "a sibling .json file holds the exact payload")
    ap.add_argument("--missing", default="",
                    help="comma-separated module sections to render as "
                         "'no data' (QA negative): e.g. verify,profile")
    ap.add_argument("--version", action="store_true",
                    help="print version and exit")
    args = ap.parse_args(argv)

    if args.version:
        print(TOOL_VERSION)
        return 0

    root = repo_root()
    missing = {s.strip() for s in args.missing.split(",") if s.strip()}
    unknown = missing - set(SECTION_ORDER)
    if unknown:
        print(f"kernscope-dashboard: unknown module(s) in --missing: "
              f"{sorted(unknown)} (known: {SECTION_ORDER})", file=sys.stderr)
        return 2

    model = build_model(root, missing)
    out_html = Path(args.out)
    try:
        out_html.parent.mkdir(parents=True, exist_ok=True)
        out_html.write_text(build_html(model), encoding="utf-8")
        out_json = out_html.with_suffix(".json")
        out_json.write_text(json.dumps(model, indent=2), encoding="utf-8")
    except OSError as e:
        print(f"kernscope-dashboard: cannot write {out_html}: {e}",
              file=sys.stderr)
        return 2

    missing_reported = [n for n in SECTION_ORDER if n in missing]
    print(f"kernscope-dashboard: wrote {out_html} "
          f"(+ {out_json.name}); sections "
          f"{[n for n in SECTION_ORDER]} "
          f"missing/no-data: {missing_reported or 'none'}")
    return 0


if __name__ == "__main__":
    sys.exit(main())

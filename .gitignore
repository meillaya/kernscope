build/
*.o
*.so
*.kcap/
caches
.devenv*
.codegraph
__pycache__/
*.pyc

# Secrets / sensitive — MUST NEVER COMMIT (PrimeIntellect rental SSH keys,
# live credentials for /home/mei/projects/tensors sibling project)
private_key.pem
public_key.pem
.env
.env.*
!.env.example

# Tooling / editor caches (clangd, etc.)
.cache/
# Local Excalidraw CLI used to render docs/diagrams (not part of the build).
.tools/

# Generated / transient artifacts (regenerated by the build or the tools)
*.verified.ll
kernscope-capture*.log
tunecache*
*.hsaco
/*.cubin
*.log

# Test / scratch leftovers
Testing/
TemporaryDirectory/

# Owner-gated NVIDIA rental run outputs — regenerable; the dir stays
# tracked via .gitkeep only
reports/rentals/*
!reports/rentals/.gitkeep

# Internal / evidence (not for the public repo).
# .omo/ is a guard preventing NEW .omo/ files from being committed.
# The orchestration runtime state (boulder, run-continuation, start-work
# ledger) is untracked; QA evidence, plans, drafts and notepads stay tracked.
.omo/
.omo/boulder.json
.omo/run-continuation/
.omo/start-work/ledger.jsonl

# Tune-run outputs (per-config db + tunecache evidence, regenerated by
# kernscope-tune on every run; the tool recreates them from scratch).
reports/tune/
